# Copy to .env and export. Never commit .env.
# Backend: mock (no GPU) | local (your ComfyUI) | comfy (Comfy Cloud, Comfy Developer Platform)
RESHOOT_BACKEND=mock
# local: native ComfyUI address (Comfy Desktop default port may differ)
COMFY_LOCAL_URL=http://127.0.0.1:8001
# Comfy Cloud (paid plan API key from platform.comfy.org). Never commit it.
COMFY_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org
# optional Cloud model overrides
# RESHOOT_CLOUD_UNET=ltx-2.5-22b-distilled-transformer-bf16.safetensors
# RESHOOT_CLOUD_LORA=ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors
# RESHOOT_CLOUD_DEPTH=depth_anything_v2_vits.pth
# GPU safety
RESHOOT_MIN_FREE_VRAM_MB=12000
RESHOOT_VRAM_ABORT_MARGIN_MB=450
RESHOOT_VRAM_HARD_MARGIN_MB=300
